# tuios: start the daemon in a capped scope, so it and every pane it holds
# (dev servers, builds) can't take the WM or the box down. The daemon stays in
# the scope of the client that starts it. Core 0 stays free; AllowedCPUs needs
# cpuset delegated to user@.service (run_onchange_after_delegate-cpuset.sh).
_tuios_capped() {
  command tuios ls >/dev/null 2>&1 && return
  systemd-run --user --scope --quiet --unit=tuios-daemon \
    -p MemoryHigh=75% -p MemoryMax=85% -p MemorySwapMax=2G \
    -p AllowedCPUs=1-$(( $(nproc) - 1 )) tuios start-server >/dev/null
}

# tuios: plain `tuios` first makes the default sessions that are missing, empty
_tuios_defaults() {
  local s id
  for s in classic v2 personal; do
    command tuios ls --json 2>/dev/null | jq -e --arg s "$s" 'any(.[]; .name == $s)' >/dev/null && continue
    command tuios new "$s" --detach >/dev/null || continue
    # --detach always opens a shell; close it so the session starts empty
    id=$(command tuios list-windows -s "$s" --json | jq -r '.windows[0].window_id')
    command tuios close-window -s "$s" "$id" >/dev/null
  done
}
tuios() {
  _tuios_capped
  [ $# -eq 0 ] && _tuios_defaults
  command tuios "$@"
}

# docker exec with auto shell detection
dexec() {
  if [ -z "$1" ]; then
    echo "Usage: dexec <container>"
    return 1
  fi
  if docker exec "$1" bash -c '' 2>/dev/null; then
    docker exec -it "$1" bash
  else
    docker exec -it "$1" sh
  fi
}

